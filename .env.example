# Copy to .env and fill in. .env is gitignored — never commit real values.

# GitHub API (personal access token, read-only public scope is enough)
GITHUB_TOKEN=

# Postgres
POSTGRES_USER=triage
POSTGRES_PASSWORD=changeme
POSTGRES_DB=triage
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5001

# Exact registered model version the API serves -- bump after promoting a new one
MODEL_VERSION=3

# local runs the model in-process; sagemaker calls the deployed endpoint, so
# predictions made against it are logged the same way. No fallback between them.
INFERENCE_BACKEND=local
SAGEMAKER_ENDPOINT_NAME=ticket-triage

# Repos to ingest, comma separated
TARGET_REPOS=huggingface/transformers,pandas-dev/pandas,scikit-learn/scikit-learn,microsoft/vscode

# AWS — leave blank until Phase 5
AWS_REGION=eu-west-2
